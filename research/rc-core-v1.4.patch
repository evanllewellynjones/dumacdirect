+/* ---------- email header block ------------------------------------------- */
+/* An email sent to the capture mailbox may lead with KEY: value lines,
+   terminated by the first blank line. Everything after that blank line is the
+   note body.
+
+   Bare KEY: value is deliberate. Outlook sends HTML by default and the reader
+   works from the plain-text conversion; asterisks and other markup survive
+   that inconsistently or arrive as tags, whereas a bare key line survives
+   every client intact and still reads naturally in a sent email.
+
+     TICKER: WOLF
+     ACTION: pass
+     BUY TARGET: 42
+     TAGS: Semiconductors, United States
+     WHY: capacity ramp isn't funded
+
+     Spoke with two accounts this morning...
+
+   Keys are case-insensitive and space-insensitive, so "Buy Target",
+   "BUY TARGET" and "buytarget" are the same key. A line that is not a known
+   key stops the header block — a note that opens "Note: saw this today" is not
+   silently eaten. Unknown keys are returned in .unknown so the caller can log
+   them rather than dropping them silently. */
+const EMAIL_KEYS = {
+  ticker:"ticker", company:"entity", entity:"entity", theme:"entity",
+  type:"record_type", recordtype:"record_type",
+  action:"action", why:"why", source:"source", date:"date",
+  strategy:"strategy",
+  tags:"tags", subject:"subject",
+  buytarget:"price_target_buy", pricetargetbuy:"price_target_buy",
+  selltarget:"price_target_sell", pricetargetsell:"price_target_sell",
+  conviction:"conviction",
+  reviewdate:"review_date", outcomecheck:"outcome_check_date",
+  outcomecheckdate:"outcome_check_date"
+};
+/* Digits are kept: "buytarget2" must NOT normalise onto "buytarget" and
+   silently overwrite a real value. */
+function normKey(k){ return String(k).toLowerCase().replace(/[^a-z0-9]/g,""); }
+
+function parseEmailHeaders(text){
+  const lines = String(text||"").replace(/\r\n/g,"\n").split("\n");
+  const fields = {}, unknown = [];
+  let i = 0, known = 0;
+  for(; i<lines.length; i++){
+    const line = lines[i];
+    if(line.trim()===""){ i++; break; }          // blank line ends the block
+    const c = line.indexOf(":");
+    if(c < 0) break;                              // not a key line at all
+    const rawKey = line.slice(0,c).trim();
+    if(!rawKey || rawKey.length > 24) break;      // prose with a colon in it
+    const nk = normKey(rawKey);
+    if(!nk) break;
+    const val = line.slice(c+1).trim();
+    if(EMAIL_KEYS[nk]){ fields[EMAIL_KEYS[nk]] = val; known++; continue; }
+    /* An unknown key AFTER a real one is almost certainly a typo inside a
+       header block: consume it and report it, so one bad line does not dump
+       the rest of the block into the body. An unknown key BEFORE any real one
+       means there is no header block — the mail just opens with prose that
+       happens to contain a colon ("Note: saw this today"). Stop and treat the
+       whole thing as body. */
+    if(known===0) break;
+    unknown.push(rawKey);
+  }
+  return { fields, unknown, body: lines.slice(i).join("\n").trim() };
+}
